# Public partner attribution ID from InstaSwap Partners. Not a secret.
VITE_INSTASWAP_AFFILIATE_ID=

# Optional public URLs. Never put private API keys in VITE_* variables.
VITE_BINANCE_REFERRAL_URL=
VITE_AI_API_URL=

# Firebase web-app configuration (public client config; secure with Firebase rules/restrictions).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
