rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Server-side checks are authoritative for direct Firestore writes.
    // They intentionally reject common identifiers and credential patterns.
    function isSafePublicText(value) {
      return value is string
        && !value.matches('(?s).*[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}.*')
        && !value.matches('(?s).*([+]?[0-9][0-9 ()-]{7,}[0-9]).*')
        && !value.matches('(?s).*[0-9]{13,19}.*')
        && !value.matches('(?s).*[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}.*')
        && !value.matches('(?s).*0x[a-fA-F0-9]{40}.*')
        && !value.matches('(?s).*[a-fA-F0-9]{64}.*')
        && !value.matches('(?is).*(password|passphrase|private key|secret key|seed phrase|recovery phrase|mnemonic|one[- ]time code|otp|cvv|cvc|كلمة المرور|كلمة السر|المفتاح الخاص|عبارة الاسترداد|رمز التحقق|رقم البطاقة|الحساب البنكي|رقم الحساب|رقم الهوية|جواز السفر|البطاقة الوطنية).*');
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isVerifiedUser()
        && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'body', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 40
        && isSafePublicText(request.resource.data.authorName)
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 1000
        && isSafePublicText(request.resource.data.body)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if exists(/databases/$(database)/documents/communityPosts/$(postId));
        allow create: if exists(/databases/$(database)/documents/communityPosts/$(postId)) && isVerifiedUser()
          && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'body', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() >= 1
          && request.resource.data.authorName.size() <= 40
          && isSafePublicText(request.resource.data.authorName)
          && request.resource.data.body is string
          && request.resource.data.body.size() >= 1
          && request.resource.data.body.size() <= 500
          && isSafePublicText(request.resource.data.body)
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isVerifiedUser() && resource.data.authorUid == request.auth.uid;
      }
    }
  }
}
