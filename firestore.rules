rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAnonymousUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isSafePublicText(value) {
      return value is string
        && !value.matches('(?s).*[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}.*')
        && !value.matches('(?s).*([+]?[0-9][0-9 ()-]{7,}[0-9]).*')
        && !value.matches('(?s).*[0-9]{13,19}.*')
        && !value.matches('(?s).*[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}.*')
        && !value.matches('(?s).*0x[a-fA-F0-9]{40}.*')
        && !value.matches('(?s).*[a-fA-F0-9]{64}.*')
        && !value.matches('(?is).*(password|passphrase|private key|secret key|seed phrase|recovery phrase|mnemonic|otp|cvv|cvc|كلمة المرور|كلمة السر|المفتاح الخاص|عبارة الاسترداد|رمز التحقق|رقم البطاقة|الحساب البنكي|رقم الحساب|رقم الهوية|جواز السفر|البطاقة الوطنية).*')
        && !value.matches('(?is).*(https?://|www\\.).*')
        && !value.matches('(?s).*[a-zA-Z0-9-]+[.](com|net|org|io|me|co).*');
    }

    // Anonymous community: a single text-only stream, no profiles, uploads, or DMs.
    match /communityMessages/{messageId} {
      allow read: if true;
      allow create: if isAnonymousUser()
        && request.resource.data.keys().hasOnly(['character', 'avatar', 'body', 'createdAt'])
        && existsAfter(/databases/$(database)/documents/communityMessageOwners/$(messageId))
        && getAfter(/databases/$(database)/documents/communityMessageOwners/$(messageId)).data.ownerUid == request.auth.uid
        && request.resource.data.character is string
        && request.resource.data.character.size() >= 1
        && request.resource.data.character.size() <= 40
        && request.resource.data.avatar in ['👻', '🦊', '🐱', '🤖', '🥷', '🐧', '👽', '🐉']
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 500
        && isSafePublicText(request.resource.data.body)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAnonymousUser()
        && exists(/databases/$(database)/documents/communityMessageOwners/$(messageId))
        && get(/databases/$(database)/documents/communityMessageOwners/$(messageId)).data.ownerUid == request.auth.uid;
    }

    // Ownership metadata is private; public message reads never reveal anonymous UIDs.
    match /communityMessageOwners/{messageId} {
      allow read: if false;
      allow create: if isAnonymousUser()
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/communityMessages/$(messageId));
      allow update: if false;
      allow delete: if isAnonymousUser() && resource.data.ownerUid == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/communityMessages/$(messageId));
    }

    // Reports contain only fixed metadata; no reporter-supplied free text or attachments.
    match /communityReports/{reportId} {
      allow read: if false;
      allow create: if isAnonymousUser()
        && request.resource.data.keys().hasOnly(['messageId', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() >= 1
        && request.resource.data.messageId.size() <= 150
        && reportId == request.resource.data.messageId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/communityMessages/$(request.resource.data.messageId))
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason == 'personal_data_or_abuse'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Retired collections from the previous community version.
    match /communityPosts/{document=**} {
      allow read, write: if false;
    }
  }
}
